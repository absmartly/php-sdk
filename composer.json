{
    "name": "absmartly/php-sdk",
    "type": "library",
    "description": "A/B Smartly PHP SDK for running experiments and feature flags with the A/B Smartly platform.",
    "homepage": "https://github.com/absmartly/php-sdk",
    "require": {
        "php-64bit": "^7.4 || ^8.0",
        "lastguest/murmurhash": "~2.1.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5.26",
        "react/http": "^1.9",
        "react/async": "^3.0 || ^4.0",
        "react/promise": "^3.0"
    },
    "suggest": {
        "react/http": "Required for the ReactPHP async HTTP client (^1.9).",
        "react/async": "Required for the ReactPHP async HTTP client (^3.0 || ^4.0).",
        "react/promise": "Required for async SDK methods (^3.0)."
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ABSmartly\\SDK\\": "src/"
        },
        "files": [
            "src/SDK.php"
        ],
        "exclude-from-classmap": [
            "src/SDK.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ABSmartly\\SDK\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Ayesh Karunaratne",
            "email": "ayesh@aye.sh"
        }
    ],
    "keywords": [
        "absmartly",
        "ab-testing",
        "split-testing",
        "experimentation",
        "feature-flags"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "support": {
        "issues": "https://github.com/absmartly/php-sdk/issues",
        "source": "https://github.com/absmartly/php-sdk"
    }
}
